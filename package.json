{
  "name": "selfimpulse",
  "private": true,
  "version": "1.9.2",
  "description": "SelfImpulse — Intelligence Meets Collaboration.",
  "author": "K.S. / SelfImpulse",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "tauri": "tauri",
    "tauri:dev": "powershell -ExecutionPolicy Bypass -File src-tauri/scripts/with-msvc.ps1 tauri dev",
    "tauri:build": "powershell -ExecutionPolicy Bypass -File src-tauri/scripts/with-msvc.ps1 tauri build",
    "desktop:build": "npm run build && powershell -ExecutionPolicy Bypass -File src-tauri/scripts/with-msvc.ps1 build --release",
    "electron:dev": "electron .",
    "electron:start": "npm run build && electron .",
    "electron:pack": "npm run build && electron-builder --dir",
    "electron:build": "npm run build && electron-builder --win nsis portable",
    "typecheck": "tsc --noEmit",
    "test": "node tools/run-all-probes.mjs",
    "test:rust": "cd src-tauri && cargo test --no-fail-fast",
    "mcp": "node tools/mcp.mjs",
    "mcp:build": "node tools/build-mcp.mjs",
    "unit": "node tools/run-unit.mjs",
    "host": "node tools/si-host.mjs",
    "host:build": "node tools/build-host.mjs",
    "web:build": "vite build && node tools/sync-web-build.mjs",
    "bump:patch": "node tools/bump-version.mjs patch",
    "bump:minor": "node tools/bump-version.mjs minor",
    "bump:show": "node tools/bump-version.mjs show",
    "test:live": "node tools/run-live-probe.mjs"
  },
  "dependencies": {
    "@blobatar/react": "^2.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-notification": "^2.3.0",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "@tauri-apps/plugin-os": "^2.3.0",
    "@tauri-apps/plugin-process": "^2.3.0",
    "3d-force-graph": "^1.80.0",
    "blobatar": "^2.7.0",
    "boring-avatars": "^2.0.4",
    "clawpdf": "^0.3.2",
    "jszip": "^3.10.2",
    "mammoth": "^1.12.3",
    "pdfjs-dist": "^6.3.289",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.3",
    "tesseract.js": "^7.0.0",
    "three": "^0.186.0",
    "zod": "^4.6.2",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tauri-apps/cli": "^2.9.0",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^6.3.5"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "electron@44.7.0": true,
    "electron-winstaller@5.4.0": true
  },
  "engine": {
    "name": "MJ",
    "version": "19.7.16",
    "codename": "Handle"
  },
  "build": {
    "appId": "com.selfimpulse.desktop",
    "productName": "SelfImpulse",
    "copyright": "Copyright (c) 2024-2026 K.S. / SelfImpulse",
    "directories": {
      "output": "release/electron",
      "buildResources": "src-tauri/icons"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json",
      "!node_modules"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "asar": true,
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "src-tauri/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SelfImpulse"
    },
    "portable": {
      "artifactName": "SelfImpulse-${version}-portable.${ext}"
    },
    "artifactName": "SelfImpulse-${version}-setup.${ext}"
  }
}
